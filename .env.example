# OpenRouter API Key for NeuroFactory Industrial AI Assistant
# Server-side proxy calls OpenRouter API securely without exposing keys in client code
OPENROUTER_API_KEY=""

# Gemini API Key (optional fallback if OpenRouter key is not set)
GEMINI_API_KEY=""

# Public Firebase Configuration (used by Firebase Auth & Cloud Firestore)
# Provided in AI Studio or your Firebase project console
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Applet hosting URL
APP_URL="MY_APP_URL"
